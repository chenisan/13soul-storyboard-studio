# 分鏡設計台設定檔範本
# 使用方式：複製一份並改名為 .env（.env 不會被 git 追蹤），再依自己的電腦修改下面的值。
# 空白或不寫就用預設值。路徑可以用絕對路徑，相對路徑以本資料夾為準。

# 網頁服務的埠號（預設 8790）。改了之後瀏覽器開 http://127.0.0.1:<埠號>/
STUDIO_PORT=8790

# 專案資料（角色卡、場景、生成的圖）存放位置，預設是本資料夾下的 projects/
STUDIO_PROJECTS_DIR=

# 生圖腳本。預設使用本資料夾附的 tools/codex_image_gen.py
# （需要先安裝 Codex CLI：npm install -g @openai/codex，再 codex login 選 Sign in with ChatGPT）
CODEX_IMAGE_GEN=

# ---- 範例對照表（node make_samples.mjs）----
# 用同一個角色、同一個場景生成各種鏡頭組合的對照圖。不做範例可以全部留空。
# 角色卡圖片的完整路徑
SAMPLE_CHARACTER_IMAGE=
# 角色名稱（中文顯示用）與英文名（寫進提示詞）
SAMPLE_CHARACTER_NAME=
SAMPLE_CHARACTER_NAME_EN=
# 角色的臉部、髮型、服裝鎖定描述（英文較準）；留空就只靠角色卡
SAMPLE_CHARACTER_LOCK=
# 場景圖片的完整路徑、名稱、英文名、描述
SAMPLE_SCENE_IMAGE=
SAMPLE_SCENE_NAME=
SAMPLE_SCENE_NAME_EN=
SAMPLE_SCENE_DESC=
# 選填：從某個既有專案沿用角色鎖定描述（同英文名的角色）、質感與規則
SAMPLE_SOURCE_PROJECT=
